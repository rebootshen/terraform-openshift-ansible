# Copy to env.local and fill in. env.local is gitignored.
# Then run ./scripts/load-env-local.sh to write the pull-secret files Ansible expects.

PROXMOX_HOST=
PROXMOX_API_URL=https://proxmox.example.com:8006/api2/json
PROXMOX_ROOT_USER=root
PROXMOX_ROOT_PASSWORD=
PVE_USER=terraform@pve
PVE_USER_PASSWORD=
PROXMOX_API_TOKEN_ID=terraform@pve!terraform-token
PROXMOX_API_SECRET=

PFSENSE_URL=https://firewall.example.com/
PFSENSE_ADMIN_USER=admin
PFSENSE_ADMIN_PASSWORD=

OKD_BASTION_HOST=
OKD_KUBEADMIN_USER=kubeadmin
OKD_KUBEADMIN_PASSWORD=

OCP_BASTION_HOST=
OCP_KUBEADMIN_USER=kubeadmin
OCP_KUBEADMIN_PASSWORD=

ARGOCD_USER=admin
ARGOCD_ADMIN_PASSWORD_B64=
ARGOCD_ADMIN_PASSWORD=

# Single-line JSON. Use the placeholder until you download a real pull secret.
OKD_PULL_SECRET='{"auths":{"fake":{"auth":"bar"}}}'
OCP_PULL_SECRET='{"auths":{"fake":{"auth":"bar"}}}'
